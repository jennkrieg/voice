# ===== Platform =====
PORT=8080
# Public HTTPS URL that Twilio, CRMs and Google can reach (your deploy URL, or an ngrok/cloudflared tunnel in dev)
PUBLIC_BASE_URL=https://voice.yourdomain.com
# Your dashboard login (created on first boot)
PLATFORM_ADMIN_EMAIL=you@youragency.com
PLATFORM_ADMIN_PASSWORD=
# Optional master API key for scripts/automation (the dashboard doesn't need it). Generate: openssl rand -base64 32
PLATFORM_ADMIN_KEY=
# Encrypts each client's CRM/calendar/email credentials at rest. Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# Postgres. Leave empty to use an embedded dev database in ./data
DATABASE_URL=postgres://user:pass@host:5432/voice

# ===== Claude (the agent's brain, call reviews, coaching reports) =====
ANTHROPIC_API_KEY=
# Default claude-opus-5-5. claude-haiku-5-5 replies faster and costs much less; compare on real calls.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# ===== Twilio (numbers, calls, SMS, transfers, recordings) =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_MACHINE_DETECTION=true

# ===== Speech to text =====
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ===== Voices =====
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# ===== Google Calendar "Connect" button (one OAuth app for all your clients) =====
# Redirect URI to register in Google Cloud: <PUBLIC_BASE_URL>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== White-label branding (what your clients see) =====
BRAND_NAME=Your Agency Voice
BRAND_LOGO_URL=https://youragency.com/logo.png
BRAND_PRIMARY_COLOR=#4f46e5
BRAND_SUPPORT_EMAIL=support@youragency.com

DIALER_ENABLED=true
LOG_LEVEL=info
